{
  "name": "carbon-scout",
  "version": "1.0.0",
  "description": "Autonomous Carbon Market Intelligence & ESG Research Agent",
  "main": "src/index.ts",
  "scripts": {
    "start": "pnpm with-env tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv run --",
    "eval:contain": "pnpm with-env tsx src/evals/contain/contain.ts",
    "eval:abstention": "pnpm with-env tsx src/evals/abstention/abstention.ts",
    "eval:faithfulness": "pnpm with-env tsx src/evals/faithfulness/faithfulness.ts",
    "eval:exact-match": "pnpm with-env tsx src/evals/exact-match/exactMatch.ts",
    "eval:all": "pnpm eval:contain && pnpm eval:abstention && pnpm eval:faithfulness && pnpm eval:exact-match"
  },
  "keywords": [
    "carbon-markets",
    "esg",
    "anvia",
    "evaluations",
    "sandbox"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anvia/core": "^1.5.0",
    "@anvia/lens": "^1.2.0",
    "@anvia/openai": "^1.1.7",
    "@anvia/sandbox": "^1.1.6",
    "@anvia/studio": "^1.3.0",
    "@tavily/core": "^0.7.13",
    "dotenv": "^18.0.4",
    "dotenv-cli": "^11.0.0",
    "zod": "^4.6.5"
  }
}
